#!/usr/bin/env bash
# spork — create a private copy of a public repository that keeps itself in
# sync with upstream via the spork sync action.
set -euo pipefail

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
root=$(dirname "$here")
# shellcheck source-path=SCRIPTDIR source=lib.sh
source "$here/lib.sh"

usage() {
  cat <<'EOF'
Usage: spork create <upstream> [options]

Create a private repository containing <upstream>'s default branch, with:
  - the upstream history on the target branch (default: upstream)
  - the same history plus a spork-sync workflow on the base branch (default: main)
  - Actions restricted to the spork action, and upstream's workflows disabled

<upstream> is owner/repo or a git URL. Authentication uses gh (GH_TOKEN or
`gh auth login`); the token needs repo creation, admin and workflow rights.

Options:
  --owner OWNER            user/org to create the repo under (default: you)
  --name NAME              repository name (default: upstream's name)
  --upstream-branch B      upstream branch to track (default: upstream's default)
  --target-branch B        branch that mirrors upstream (default: upstream)
  --base-branch B          your working/default branch (default: main)
  --on-update MODE         pr | none | fast-forward | merge (default: pr)
  --schedule CRON          sync schedule (default: "23 */6 * * *")
  --runs-on LABELS         runner for the sync job, e.g. self-hosted or
                           "[self-hosted, linux]" (default: ubuntu-latest)
  --action-ref REF         sync action to use (default: Shardbyte/spork@v1)
  --sync-tags              also mirror upstream tags
  --auth token|app         how the sync authenticates (default: token)
  --admin-auth gh|app      how this script authenticates: gh (GH_TOKEN or
                           `gh auth login`, default) or app (the GitHub App
                           from SPORK_APP_ID/SPORK_APP_PRIVATE_KEY; --owner
                           must be an organization the App is installed on)
  --dry-run                prepare everything locally, create nothing

Sync credentials are read from the environment and stored in the new repo:
  --auth token  SPORK_TOKEN                -> secret SPORK_TOKEN
  --auth app    SPORK_APP_ID               -> variable SPORK_APP_ID
                SPORK_APP_PRIVATE_KEY      -> secret SPORK_APP_PRIVATE_KEY
                (or SPORK_APP_PRIVATE_KEY_FILE, a path to the .pem)
The App must be installed on the new repository (e.g. on all repositories).
In an organization on a paid plan, credentials that already exist as
org-level secrets / variables are not copied into the repository (for
"selected repositories" visibility, the new repository is added to the list).
On GitHub Free, private repositories can't use org-level credentials, so they
are always stored in the repository.
Missing values are reported; set them yourself before the first sync.
EOF
}

cmd=${1:-}
[[ $# -eq 0 ]] || shift
case $cmd in
  create) ;;
  -h | --help | help | "")
    usage
    exit 0
    ;;
  *) spork_die "unknown command '$cmd' (try: spork --help)" ;;
esac

upstream="" owner="" name="" upstream_branch="" target=upstream base=main
on_update=pr schedule="23 */6 * * *" action_ref="$SPORK_ACTION_REPO@v1"
sync_tags=false dry_run=false runs_on=ubuntu-latest auth=token admin_auth=gh

need() { [[ $# -ge 2 && -n $2 ]] || spork_die "$1 needs a value"; }
while [[ $# -gt 0 ]]; do
  case $1 in
    --owner) need "$@"; owner=$2; shift 2 ;;
    --name) need "$@"; name=$2; shift 2 ;;
    --upstream-branch) need "$@"; upstream_branch=$2; shift 2 ;;
    --target-branch) need "$@"; target=$2; shift 2 ;;
    --base-branch) need "$@"; base=$2; shift 2 ;;
    --on-update) need "$@"; on_update=$2; shift 2 ;;
    --schedule) need "$@"; schedule=$2; shift 2 ;;
    --runs-on) need "$@"; runs_on=$2; shift 2 ;;
    --action-ref) need "$@"; action_ref=$2; shift 2 ;;
    --sync-tags) sync_tags=true; shift ;;
    --auth) need "$@"; auth=$2; shift 2 ;;
    --admin-auth) need "$@"; admin_auth=$2; shift 2 ;;
    --dry-run) dry_run=true; shift ;;
    -h | --help) usage; exit 0 ;;
    -*) spork_die "unknown option $1" ;;
    *)
      [[ -z $upstream ]] || spork_die "unexpected argument $1"
      upstream=$1
      shift
      ;;
  esac
done

[[ -n $upstream ]] || spork_die "missing <upstream> (try: spork --help)"
case $auth in
  token | app) ;;
  *) spork_die "--auth must be token or app" ;;
esac
case $admin_auth in
  gh | app) ;;
  *) spork_die "--admin-auth must be gh or app" ;;
esac
if [[ -z ${SPORK_APP_PRIVATE_KEY:-} && -n ${SPORK_APP_PRIVATE_KEY_FILE:-} ]]; then
  SPORK_APP_PRIVATE_KEY=$(<"$SPORK_APP_PRIVATE_KEY_FILE")
fi
case $on_update in
  none | pr | fast-forward | merge) ;;
  *) spork_die "--on-update must be one of: none, pr, fast-forward, merge" ;;
esac
[[ $target != "$base" ]] || spork_die "--target-branch and --base-branch must differ"
[[ $action_ref == */*@* ]] || spork_die "--action-ref must look like owner/repo@ref"
spork_have_gh || spork_die "the GitHub CLI (gh) is required"

upstream_url=$(spork_normalize_url "$upstream")
if [[ -z $name ]]; then
  name=$(basename "${upstream_url%/}")
  name=${name%.git}
fi
if [[ $admin_auth == app ]]; then
  [[ -n $owner ]] || spork_die "--admin-auth app needs --owner <organization>"
  [[ -n ${SPORK_APP_ID:-} && -n ${SPORK_APP_PRIVATE_KEY:-} ]] ||
    spork_die "--admin-auth app needs SPORK_APP_ID and SPORK_APP_PRIVATE_KEY (or SPORK_APP_PRIVATE_KEY_FILE)"
  spork_app_token "$SPORK_APP_ID" "$SPORK_APP_PRIVATE_KEY" "$owner" ||
    spork_die "could not authenticate as GitHub App $SPORK_APP_ID on $owner (is it installed on the organization?)"
  export GH_TOKEN=$SPORK_APP_TOKEN
  spork_log "authenticated as GitHub App $SPORK_APP_ID on $owner"
fi
[[ -n $owner ]] || owner=$(gh api user --jq .login)
owner_type=$(gh api "users/$owner" --jq .type) || spork_die "account $owner not found"
repo="$owner/$name"
origin_url="${GITHUB_SERVER_URL:-https://github.com}/$repo.git"

if [[ -z $upstream_branch ]]; then
  upstream_branch=$(spork_default_branch git "$upstream_url")
  [[ -n $upstream_branch ]] || spork_die "could not determine default branch of $upstream_url"
fi
if ! $dry_run && gh api "repos/$repo" >/dev/null 2>&1; then
  spork_die "$repo already exists"
fi

# Org-level secrets/variables reach private repositories only on paid plans
# (not GitHub Free). Use them only when the plan is known to allow it.
org_credentials=false
if [[ $owner_type == Organization ]]; then
  org_plan=$(gh api "orgs/$owner" --jq '.plan.name // ""' 2>/dev/null || true)
  if [[ -n $org_plan && $org_plan != free ]]; then org_credentials=true; fi
fi

# Organization Actions policy: fail before creating anything if it would
# block spork. Reading it needs org admin (admin:org); skip if we can't.
org_enable_repo=false
if [[ $owner_type == Organization ]]; then
  if policy=$(gh api "orgs/$owner/actions/permissions" --jq '"\(.enabled_repositories) \(.allowed_actions)"' 2>/dev/null); then
    read -r org_enabled org_allowed <<<"$policy"
    case $org_enabled in
      none) spork_die "Actions is disabled for all repositories in $owner" ;;
      selected) org_enable_repo=true ;;
    esac
    case $org_allowed in
      local_only) spork_die "$owner only allows local actions; allow ${action_ref%@*}@* in its Actions settings" ;;
      selected)
        allowed=false
        while read -r pattern; do
          # shellcheck disable=SC2053 # pattern is a glob on purpose
          if [[ -n $pattern && $action_ref == $pattern ]]; then allowed=true; fi
        done < <(gh api "orgs/$owner/actions/permissions/selected-actions" --jq '.patterns_allowed[]')
        $allowed || spork_die "$owner's allowed actions don't include $action_ref; add ${action_ref%@*}@* in its Actions settings"
        ;;
    esac
    spork_log "org Actions policy ok (repositories: $org_enabled, actions: $org_allowed)"
  else
    spork_warn "cannot read $owner's Actions policy (needs org admin); skipping the check"
  fi
fi

# ---------------------------------------------------------------------------
# Prepare history locally.

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
git init -q --bare "$work/repo.git"
spork_log "fetching $upstream_url $upstream_branch (full history)"
git --git-dir="$work/repo.git" fetch --no-tags "$upstream_url" "+refs/heads/$upstream_branch:refs/spork/upstream"
upstream_sha=$(git --git-dir="$work/repo.git" rev-parse refs/spork/upstream)

# Render the workflow template. Values are inserted literally via awk.
# shellcheck disable=SC2016 # literal ${{ }} for the workflow file
if [[ $auth == app ]]; then
  # awk -v turns \n into a newline.
  auth_block='app-id: ${{ vars.SPORK_APP_ID }}\n          app-private-key: ${{ secrets.SPORK_APP_PRIVATE_KEY }}'
else
  auth_block='token: ${{ secrets.SPORK_TOKEN }}'
fi
render() {
  awk -v url="$upstream_url" -v ub="$upstream_branch" -v tb="$target" \
    -v mode="$on_update" -v cron="$schedule" -v ref="$action_ref" -v tags="$sync_tags" -v runson="$runs_on" -v auth="$auth_block" '
    function rep(s, k, v,   i) {
      while ((i = index(s, k)) > 0) s = substr(s, 1, i - 1) v substr(s, i + length(k))
      return s
    }
    {
      $0 = rep($0, "__UPSTREAM_URL__", url); $0 = rep($0, "__UPSTREAM_BRANCH__", ub)
      $0 = rep($0, "__TARGET_BRANCH__", tb); $0 = rep($0, "__ON_UPDATE__", mode)
      $0 = rep($0, "__SCHEDULE__", cron);    $0 = rep($0, "__ACTION_REF__", ref)
      $0 = rep($0, "__SYNC_TAGS__", tags);  $0 = rep($0, "__RUNS_ON__", runson)
      $0 = rep($0, "__AUTH__", auth)
      print
    }' "$root/templates/spork-sync.yml"
}
render >"$work/spork-sync.yml"
self_wf=.github/workflows/spork-sync.yml

spork_ensure_identity
export GIT_INDEX_FILE="$work/index"
git --git-dir="$work/repo.git" read-tree "$upstream_sha"
blob=$(git --git-dir="$work/repo.git" hash-object -w "$work/spork-sync.yml")
git --git-dir="$work/repo.git" update-index --add --cacheinfo "100644,$blob,$self_wf"
tree=$(git --git-dir="$work/repo.git" write-tree)
unset GIT_INDEX_FILE
base_sha=$(git --git-dir="$work/repo.git" commit-tree "$tree" -p "$upstream_sha" \
  -m "Add spork sync workflow" \
  -m "Keeps '$target' in sync with $upstream_url ($upstream_branch).")

# Upstream workflows that will need disabling.
expected_foreign=$(git --git-dir="$work/repo.git" ls-tree --name-only "$base_sha" .github/workflows/ |
  grep -E '\.ya?ml$' | grep -cvxF "$self_wf" || true)

if $dry_run; then
  spork_log "dry run — would create private repo $repo"
  spork_log "  $target  <- $upstream_sha (upstream $upstream_branch)"
  spork_log "  $base    <- $base_sha (+ $self_wf)"
  spork_log "  upstream workflows to disable: $expected_foreign"
  printf '\n--- %s ---\n' "$self_wf"
  cat "$work/spork-sync.yml"
  exit 0
fi

# ---------------------------------------------------------------------------
# Create and populate the repository.

api_put() { gh api -X PUT "repos/$repo/$1" --input - >/dev/null <<<"$2"; }

spork_log "creating private repository $repo"
create_path=user/repos
[[ $owner_type != Organization ]] || create_path="orgs/$owner/repos"
repo_id=$(gh api "$create_path" -f name="$name" -F private=true \
  -f description="Private copy of $upstream_url (managed by spork)" --jq .id)
if $org_enable_repo; then
  gh api -X PUT "orgs/$owner/actions/permissions/repositories/$repo_id" >/dev/null ||
    spork_warn "$owner enables Actions only for selected repositories, and adding $repo failed; add it in the org's Actions settings"
fi

# Push with Actions disabled so upstream workflows never get triggered.
api_put actions/permissions '{"enabled": false}'

spork_set_auth "${GH_TOKEN:-$(gh auth token)}"
spork_log "pushing $target and $base"
ogit --git-dir="$work/repo.git" push -q "$origin_url" \
  "$upstream_sha:refs/heads/$target" "$base_sha:refs/heads/$base"
gh api -X PATCH "repos/$repo" -f default_branch="$base" >/dev/null

# Push events are processed asynchronously; events handled while Actions is
# still disabled are dropped. Give them time before re-enabling.
spork_log "waiting for push events to settle"
sleep "${SPORK_SETTLE_SECONDS:-20}"

spork_log "restricting Actions to ${action_ref%@*}"
api_put actions/permissions '{"enabled": true, "allowed_actions": "selected"}'
api_put actions/permissions/selected-actions \
  "{\"github_owned_allowed\": false, \"verified_allowed\": false, \"patterns_allowed\": [\"${action_ref%@*}@*\"]}"
api_put actions/permissions/workflow \
  '{"default_workflow_permissions": "read", "can_approve_pull_request_reviews": false}'

# Workflows register asynchronously once Actions is enabled.
# Keep sweeping for a while: disables workflows as they register and
# cancels any run that slipped through.
if ((expected_foreign > 0)); then
  spork_log "disabling $expected_foreign upstream workflow(s)"
  for _ in $(seq 1 8); do
    spork_disable_foreign_workflows "$repo" "$self_wf"
    sleep 5
  done
  if ((SPORK_FOREIGN_SEEN < expected_foreign)); then
    spork_warn "only $SPORK_FOREIGN_SEEN of $expected_foreign upstream workflows registered yet; the first sync run will disable the rest"
  fi
fi

# store_credential secret|variable NAME VALUE — prefer an existing org-level
# credential; otherwise store it in the repository.
store_credential() {
  local kind=$1 cname=$2 value=$3 vis
  if [[ $owner_type == Organization ]] && ! $org_credentials &&
    gh api "orgs/$owner/actions/${kind}s/$cname" >/dev/null 2>&1; then
    spork_log "org $kind $cname exists, but org credentials don't reach private repositories on the ${org_plan:-current} plan; storing it in the repository"
  fi
  if $org_credentials &&
    vis=$(gh api "orgs/$owner/actions/${kind}s/$cname" --jq .visibility 2>/dev/null); then
    if [[ $vis == selected ]]; then
      if gh api -X PUT "orgs/$owner/actions/${kind}s/$cname/repositories/$repo_id" >/dev/null 2>&1; then
        spork_log "gave $repo access to org $kind $cname"
      else
        spork_warn "org $kind $cname is limited to selected repositories; add $repo to it"
      fi
    else
      spork_log "using org-level $kind $cname (visibility: $vis)"
    fi
    return 0
  fi
  if [[ -z $value ]]; then
    spork_warn "$cname not set — add it before the first sync: gh $kind set $cname -R $repo"
  elif [[ $kind == secret ]]; then
    printf '%s' "$value" | gh secret set "$cname" -R "$repo"
    spork_log "stored $kind $cname"
  else
    gh variable set "$cname" -R "$repo" --body "$value" >/dev/null
    spork_log "stored $kind $cname"
  fi
}

if [[ $auth == token ]]; then
  store_credential secret SPORK_TOKEN "${SPORK_TOKEN:-}"
else
  store_credential variable SPORK_APP_ID "${SPORK_APP_ID:-}"
  store_credential secret SPORK_APP_PRIVATE_KEY "${SPORK_APP_PRIVATE_KEY:-}"
  if [[ -n ${SPORK_APP_ID:-} && -n ${SPORK_APP_PRIVATE_KEY:-} ]]; then
    if spork_app_token "$SPORK_APP_ID" "$SPORK_APP_PRIVATE_KEY" "$repo"; then
      spork_log "verified: GitHub App $SPORK_APP_ID can access $repo"
    else
      spork_warn "install the GitHub App on $repo before the first sync"
    fi
  fi
fi

url="${GITHUB_SERVER_URL:-https://github.com}/$repo"
spork_output repository "$repo"
spork_output url "$url"
spork_log "done: $url"
